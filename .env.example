# Modelo das variáveis de ambiente do contAI.
# Copie para .env.local e preencha os valores lá — .env.local é ignorado pelo Git.
#
#   cp .env.example .env.local
#
# Regra de ouro: tudo que começa com VITE_ é embutido no JavaScript enviado ao
# navegador. Só coloque aqui valores que podem ser públicos. Chaves secretas
# (sb_secret_, service_role, chaves de provedores de IA) pertencem ao servidor.

# URL do projeto Supabase — Project Settings > Data API > Project URL
VITE_SUPABASE_URL=

# Chave publicável do Supabase (sb_publishable_…)
# Project Settings > API Keys > Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend próprio que encapsula OCR e modelo de linguagem.
# Nenhuma chave de API de IA deve ser colocada no frontend: este endpoint roda
# no servidor e guarda as credenciais dos provedores.
# Sem esta variável, o contAI roda em modo demonstração (extração local simulada).
VITE_IA_ENDPOINT=
