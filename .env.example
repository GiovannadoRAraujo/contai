# Modelo das variáveis de ambiente do contAI.
# Copie para .env.local e preencha lá — .env.local é ignorado pelo Git.
#
#   cp .env.example .env.local
#
# Regra de ouro: tudo que começa com VITE_ é embutido no JavaScript enviado ao
# navegador. Só coloque aqui valores que podem ser públicos. Chaves de
# provedores de IA pertencem ao servidor (ver README, "Backend de IA").

# Backend próprio que encapsula OCR e modelo de linguagem (opcional).
# Sem esta variável o contAI lê PDFs e imagens localmente no navegador
# (pdf.js + Tesseract) e o assistente usa o motor local de cálculo.
VITE_IA_ENDPOINT=

# Conta opcional e sincronização entre aparelhos (Supabase).
# Sem estas variáveis, o app funciona só com os dados locais.
# Project Settings > Data API > Project URL
VITE_SUPABASE_URL=
# Project Settings > API Keys > Publishable key (sb_publishable_…). NUNCA a secreta.
VITE_SUPABASE_PUBLISHABLE_KEY=
